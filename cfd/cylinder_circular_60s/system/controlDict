FoamFile {version 2.0; format ascii; class dictionary; object controlDict;}
application pimpleFoam;
startFrom startTime; startTime 0; stopAt endTime; endTime 10;
deltaT 0.000625; adjustTimeStep no;
writeControl runTime; writeInterval 2; purgeWrite 0;
writeFormat binary; writePrecision 12; writeCompression off;
timeFormat general; timePrecision 10; runTimeModifiable false;
functions {
yPlus {type yPlus; libs ("libfieldFunctionObjects.so"); executeControl runTime; executeInterval 0.5; writeControl writeTime; log false;}
forces {type forces; libs ("libforces.so"); patches (cylinder); rho rhoInf; rhoInf 1000; CofR (0 0 0); log false; writeControl timeStep; writeInterval 1;}
curle {type CurleAnalogy; libs ("libAcoustics.so"); patches (cylinder); p p; U U;
        rho rhoInf; rhoInf 1000; CofR (0 0 0); log false;
        timeStart 0; timeEnd 100; probeFrequency 1; writeFft false; c0 1500;
        executeControl timeStep; executeInterval 1;
        writeControl timeStep; writeInterval 1;
        observers {cross_plus {position (0.0 1.0 0.0); pRef 1e-6; fftFreq 1024;}
cross_minus {position (0.0 -1.0 0.0); pRef 1e-6; fftFreq 1024;}
downstream {position (1.0 0.0 0.0); pRef 1e-6; fftFreq 1024;}
oblique {position (0.6 0.8 0.0); pRef 1e-6; fftFreq 1024;}
cross_double {position (0.0 2.0 0.0); pRef 1e-6; fftFreq 1024;}}}
fwh {type FfowcsWilliamsHawkings; libs ("libAcoustics.so"); patches (cylinder); p p; U U;
        rho rhoInf; rhoInf 1000; CofR (0 0 0); log false;
        timeStart 0; timeEnd 100; probeFrequency 1; writeFft false; c0 1500;
        executeControl timeStep; executeInterval 1;
        writeControl timeStep; writeInterval 1;
        observers {cross_plus {position (0.0 1.0 0.0); pRef 1e-6; fftFreq 1024;}
cross_minus {position (0.0 -1.0 0.0); pRef 1e-6; fftFreq 1024;}
downstream {position (1.0 0.0 0.0); pRef 1e-6; fftFreq 1024;}
oblique {position (0.6 0.8 0.0); pRef 1e-6; fftFreq 1024;}
cross_double {position (0.0 2.0 0.0); pRef 1e-6; fftFreq 1024;}}
formulationType Farassat1AFormulation; pInf 0; Ufwh (0 0 0); U0 (0 0 0);
fixedResponseDelay false; nonUniformSurfaceMotion false; cleanFreq 20;
interpolationScheme cell;
surfaces (body {type patch; patches (cylinder); interpolate false; triangulate false;});
}
vorticity {type vorticity; libs ("libfieldFunctionObjects.so"); executeControl runTime; executeInterval 0.5; writeControl writeTime;}
wallHistory {type surfaces; libs ("libsampling.so"); writeControl runTime; writeInterval 0.02;
surfaceFormat raw; fields (p); interpolationScheme cell;
surfaces (body {type patch; patches (cylinder); interpolate false; triangulate false;});
}
flowSlice {type surfaces; libs ("libsampling.so"); writeControl runTime; writeInterval 0.5;
surfaceFormat raw; fields (U vorticity); interpolationScheme cellPoint;
surfaces (
midspan {type cuttingPlane; planeType pointAndNormal; pointAndNormalDict {point (0 0 0); normal (0 0 1);} interpolate true;}
tipplane {type cuttingPlane; planeType pointAndNormal; pointAndNormalDict {point (0 0 0.035); normal (0 0 1);} interpolate true;}
);
}
}
